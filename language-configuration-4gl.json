{
  "comments": {
    "lineComment": "--",
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(IF|FOR|FOREACH|WHILE|MAIN|FUNCTION)\\b",
      "end": "^\\s*END\\s+(IF|FOR|FOREACH|WHILE|MAIN|FUNCTION)\\b"
    }
  }
}
