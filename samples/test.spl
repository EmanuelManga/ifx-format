DROP PROCEDURE IF EXISTS sp_demo_inventory_sync;
CREATE PROCEDURE sp_demo_inventory_sync(
  p_warehouse_id INTEGER,
  p_sku CHAR(32),
  p_force_resync SMALLINT,
  p_cutoff_date DATE
  )
  RETURNING
  INTEGER AS warehouse_id,
  CHAR(32) AS sku,
  INTEGER AS qty_on_hand,
  DECIMAL(18, 2) AS unit_cost,
  CHAR(1) AS status_flag;

  DEFINE l_qty INTEGER;
  DEFINE l_reserved INTEGER;
  DEFINE l_available INTEGER;
  DEFINE l_unit_cost DECIMAL(18, 2);
  DEFINE l_avg_cost DECIMAL(18, 2);
  DEFINE l_status CHAR(1);
  DEFINE l_supplier_id INTEGER;
  DEFINE l_lead_days SMALLINT;
  DEFINE l_batch_no INTEGER;
  DEFINE l_line INTEGER;
  DEFINE l_ok SMALLINT;
  DEFINE l_msg CHAR(80);
  DEFINE l_min_qty INTEGER;
  DEFINE l_max_qty INTEGER;

  LET l_qty = 0;
  LET l_reserved = 0;
  LET l_available = 0;
  LET l_unit_cost = 0;
  LET l_avg_cost = 0;
  LET l_status = 'P';
  LET l_ok = 0;
  LET l_msg = 'PENDING';
  LET l_batch_no = 0;
  LET l_line = 0;

  -- Params + nested IF
  IF p_warehouse_id IS NULL OR p_warehouse_id <= 0 THEN

    LET l_status = 'E';
    LET l_msg = 'INVALID WAREHOUSE';

    RETURN p_warehouse_id, p_sku, 0, 0, l_status;

  ELSE

    IF p_sku IS NULL OR LENGTH(TRIM(p_sku)) = 0 THEN

      LET l_status = 'E';
      LET l_msg = 'INVALID SKU';

      RETURN p_warehouse_id, p_sku, 0, 0, l_status;

    END IF;
  END IF;

  -- Query with subquery in SELECT / WHERE
  SELECT
    NVL(i.qty_on_hand, 0),
    NVL(i.qty_reserved, 0),
    NVL(i.unit_cost, 0),
    NVL(i.min_qty, 0),
    NVL(i.max_qty, 0),
    i.supplier_id,
    (
      SELECT NVL(AVG(c.unit_cost), 0)
        FROM stock_cost_hist c
        WHERE c.sku = i.sku
          AND c.warehouse_id = i.warehouse_id
          AND c.cost_date >= p_cutoff_date
      )
    INTO
    l_qty,
    l_reserved,
    l_unit_cost,
    l_min_qty,
    l_max_qty,
    l_supplier_id,
    l_avg_cost
    FROM inventory i
    WHERE i.warehouse_id = p_warehouse_id
      AND i.sku = p_sku
      AND i.sku IN (
        SELECT s.sku
          FROM sku_master s
          WHERE s.active_flag = 'Y'
            AND s.sku_type IN (
              SELECT t.sku_type
                FROM sku_type t
                WHERE t.allow_sync = 'Y'
              )
        );

  LET l_available = l_qty - l_reserved;

  IF l_available < 0 THEN

    LET l_available = 0;

  END IF;

  -- FOR with nested IF / SELECT
  FOR l_line = 1 TO 3 STEP 1
    IF l_line = 1 THEN

        SELECT COUNT(*)
        INTO l_batch_no
        FROM sync_batch b
        WHERE b.warehouse_id = p_warehouse_id
          AND b.created_on >= (
            SELECT MAX(x.created_on)
              FROM sync_batch x
              WHERE x.warehouse_id = p_warehouse_id
                AND x.status_flag = 'C'
            );

    ELIF l_line = 2 THEN

      IF p_force_resync = 1 THEN

        LET l_ok = 1;
        LET l_msg = 'FORCE RESYNC';

      ELSE

        IF l_available < l_min_qty THEN

          LET l_ok = 1;
          LET l_msg = 'BELOW MIN';

        ELSE

          IF l_available > l_max_qty THEN

            LET l_ok = 1;
            LET l_msg = 'ABOVE MAX';

          ELSE

            LET l_ok = 0;
            LET l_msg = 'IN RANGE';

          END IF;
        END IF;
      END IF;

    ELSE

        UPDATE inventory
        SET last_check = TODAY,
        notes = l_msg
        WHERE warehouse_id = p_warehouse_id
          AND sku = p_sku
          AND sku NOT IN (
            SELECT h.sku
              FROM inventory_hold h
              WHERE h.hold_flag = 'Y'
                AND h.warehouse_id = p_warehouse_id
            );

    END IF;
  END FOR;
  -- FOREACH over cursor with nested FOR + IF + subquery DML
  FOREACH
      SELECT o.order_id, o.order_qty, o.supplier_id
      INTO l_batch_no, l_qty, l_supplier_id
      FROM purchase_order o
      WHERE o.sku = p_sku
        AND o.warehouse_id = p_warehouse_id
        AND o.status_flag = 'O'
        AND o.order_id IN (
          SELECT d.order_id
            FROM purchase_order_det d
            WHERE d.sku = p_sku
              AND d.qty_pending > 0
          )
        ORDER BY o.order_date
    LET l_lead_days = 0;

    SELECT NVL(s.lead_days, 7)
      INTO l_lead_days
      FROM supplier s
      WHERE s.supplier_id = l_supplier_id
        AND s.supplier_id = (
          SELECT MIN(s2.supplier_id)
            FROM supplier s2
            WHERE s2.active_flag = 'Y'
              AND s2.region_code = (
                SELECT w.region_code
                  FROM warehouse w
                  WHERE w.warehouse_id = p_warehouse_id
                )
          );

    FOR l_line = 1 TO l_lead_days STEP 1
      IF MOD(l_line, 2) = 0 THEN

        IF l_qty > l_available THEN

            INSERT INTO sync_audit (
              warehouse_id,
              sku,
              batch_no,
              line_no,
              audit_msg,
              created_on
              )
            VALUES (
              p_warehouse_id,
              p_sku,
              l_batch_no,
              l_line,
              'SHORTAGE',
              CURRENT
              );

        ELSE

            INSERT INTO sync_audit (
              warehouse_id,
              sku,
              batch_no,
              line_no,
              audit_msg,
              created_on
              )
            SELECT
            p_warehouse_id,
            p_sku,
            l_batch_no,
            l_line,
            'OK',
            CURRENT
            FROM dual
            WHERE NOT EXISTS (
              SELECT 1
                FROM sync_audit a
                WHERE a.warehouse_id = p_warehouse_id
                  AND a.sku = p_sku
                  AND a.batch_no = l_batch_no
                  AND a.line_no = l_line
              );

        END IF;
      END IF;
    END FOR;
    IF l_ok = 1 THEN

        UPDATE purchase_order
        SET status_flag = 'S',
        synced_on = CURRENT
        WHERE order_id = l_batch_no
          AND order_id NOT IN (
            SELECT e.order_id
              FROM purchase_order_err e
              WHERE e.fatal_flag = 'Y'
            );

    END IF;
  END FOREACH;
  -- Final nested IF chain
  IF l_status = 'P' THEN

    IF l_ok = 1 THEN

      LET l_status = 'S';

    ELSE

      IF l_available = 0 THEN

        LET l_status = 'Z';

      ELSE

        LET l_status = 'O';

      END IF;
    END IF;
  END IF;

  RETURN p_warehouse_id, p_sku, l_available, l_avg_cost, l_status;
END PROCEDURE;
