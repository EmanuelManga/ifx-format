{
  "File header": {
    "prefix": ["header", "encabezado"],
    "body": [
      "{",
      "******************************************************************************",
      "* Module......: ${1:$TM_FILENAME}",
      "* Description.: ${2}",
      "* Version.....: ${3:1.0.0}",
      "* Author......: ${4}",
      "* Date........: ${5:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}",
      "* History.....:",
      "*   ${5}  ${4}  creación",
      "******************************************************************************",
      "}",
      ""
    ],
    "description": "Encabezado de módulo Informix 4GL"
  },
  "MAIN skeleton": {
    "prefix": ["main", "main4gl"],
    "body": [
      "DATABASE ${1:database}",
      "",
      "MAIN",
      "  ${2}",
      "END MAIN",
      ""
    ],
    "description": "Esqueleto DATABASE + MAIN / END MAIN"
  },
  "FUNCTION skeleton": {
    "prefix": ["function", "func"],
    "body": [
      "FUNCTION ${1:ff_nombre}(${2})",
      "  DEFINE ${3}",
      "",
      "  ${4}",
      "END FUNCTION",
      ""
    ],
    "description": "Esqueleto FUNCTION / END FUNCTION"
  }
}
